#version 430
// One simulation step for every dust particle. See dust.py for the layout and
// for why the CPU never touches a particle.
//
// A particle belongs to a cloud (index / uPerCloud) and has a *home*: a fixed
// random offset from the cloud's centre, slowly rotated so the cloud churns
// rather than translating rigidly. A spring pulls it home -- this is the
// stand-in for the cloud's self-gravity -- and a cheap divergence-ish sine
// field stirs it so the edges stay wispy instead of settling into a ball.
//
// pos.w holds the cloud generation the particle was seeded for. When the CPU
// respawns a cloud it bumps the generation, and every particle of that cloud
// re-seeds itself here on the next step. That is the whole respawn protocol.

layout(local_size_x = 128) in;

struct Particle {
    vec4 pos;   // xyz world position, w = generation seeded for
    vec4 vel;   // xyz velocity, w unused
};

struct Cloud {
    vec4 center;  // xyz, w = radius
    vec4 vel;     // xyz drift, w = generation
    vec4 color;   // rgb tint, w = albedo
    vec4 shape;   // x = anisotropy g, y = active fraction, z = opacity scale, w = seed
    vec4 extra;   // x = fade-in 0..1, y = swirl rate, zw unused
};

layout(std430, binding = 0) buffer Particles { Particle particles[]; };
layout(std430, binding = 1) readonly buffer Clouds { Cloud clouds[]; };

uniform int uPerCloud;
uniform int uCloudCount;
uniform float uDt;
uniform float uTime;
uniform float uCohesion;    // spring constant toward home, 1/s^2
uniform float uDrag;        // damping of velocity relative to the cloud, 1/s
uniform float uTurbulence;  // strength of the stirring field, units/s^2

// Eddies (eddies.py). pos.w = pull (mass * envelope; 0 = absent or spent),
// axis.w = orbit direction (+-1).
const int MAX_EDDIES = 8;
uniform int uEddyCount;
uniform vec4 uEddyPos[MAX_EDDIES];
uniform vec4 uEddyAxis[MAX_EDDIES];
// Supernova per eddy: x = shock radius, y = push, z/w (flash, reach) are for
// the lighting. y == 0 means no blast in progress.
uniform vec4 uEddyNova[MAX_EDDIES];
uniform float uEddyCapture;    // capture radius, scene units
uniform float uEddySoftening;  // gravity softening length
uniform float uEddyLock;       // 1/s: how hard captured dust is steered onto its orbit
uniform float uEddyFlatten;    // spring toward the orbital plane, 1/s^2
uniform float uEddyTilt;       // per-particle spread of orbital planes, 0 = one clean disk
uniform float uEddyOrbit;      // outer orbital radius; each grain picks 35-100% of it
uniform float uEddyOrbitSpeed; // multiplier on the Keplerian speed at that radius

// Integer hash -> [0,1). Stable across drivers, unlike sin-based hashes.
float hash(uint x) {
    x ^= x >> 16; x *= 0x7feb352du;
    x ^= x >> 15; x *= 0x846ca68bu;
    x ^= x >> 16;
    return float(x) / 4294967296.0;
}

// Roughly Gaussian offset (sum of uniforms), unit-ish spread.
vec3 homeOffset(uint id, uint seed) {
    vec3 o = vec3(0.0);
    for (uint k = 0u; k < 3u; ++k) {
        o += vec3(hash(id * 9u + k * 3u + seed * 7919u),
                  hash(id * 9u + k * 3u + 1u + seed * 7919u),
                  hash(id * 9u + k * 3u + 2u + seed * 7919u));
    }
    return (o - 1.5) * 0.9;  // var of sum of 3 uniforms is 0.25; * 0.9 ~ sigma 0.45
}

vec3 rotateAbout(vec3 v, vec3 axis, float a) {
    float c = cos(a), s = sin(a);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0 - c);
}

vec3 stir(vec3 p, float t) {
    // Three phase-shifted sine waves per axis, each reading the other two
    // axes: close enough to a curl field to swirl without visibly pumping.
    return vec3(
        sin(p.y * 1.7 + t * 0.31) + sin(p.z * 2.3 - t * 0.23),
        sin(p.z * 1.9 + t * 0.27) + sin(p.x * 2.1 + t * 0.19),
        sin(p.x * 1.5 - t * 0.29) + sin(p.y * 2.5 + t * 0.21)) * 0.5;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    int ci = int(i) / uPerCloud;
    if (ci >= uCloudCount) return;

    Cloud cl = clouds[ci];
    Particle p = particles[i];
    uint seed = uint(cl.shape.w);
    float radius = cl.center.w;

    vec3 off = homeOffset(i, seed) * radius;
    vec3 axis = normalize(vec3(hash(seed * 3u + 11u), hash(seed * 5u + 13u),
                               hash(seed * 7u + 17u)) - 0.5);
    // Differential rotation: the core turns faster than the rim, which is what
    // drags the rim out into spiral wisps.
    float r = length(off) / max(radius, 1e-3);
    off = rotateAbout(off, axis, uTime * cl.extra.y / (0.35 + r));
    vec3 home = cl.center.xyz + off;

    if (p.pos.w != cl.vel.w) {
        p.pos = vec4(home, cl.vel.w);
        p.vel = vec4(cl.vel.xyz, 0.0);
    } else {
        // Eddies. Free dust feels plain softened gravity (what makes fast
        // dust slingshot past instead of being caught). Captured dust is
        // *steered onto a prescribed orbit* instead: each grain has its own
        // radius (35-100% of uEddyOrbit) and its own copy of the spin axis,
        // tilted by up to uEddyTilt, and is pulled toward three things at
        // once -- the orbital speed, its radius, and its plane.
        //
        // Prescribed rather than emergent on purpose. The first version only
        // steered the *velocity* and let gravity do the rest, and measured
        // (particle readback) it did two bad things: dust spiralled into a
        // ball the size of the softening length, and grains on tilted planes
        // were flung to the capture edge where the cohesion spring held them
        // in a shell -- which, wrapped round the camera's line of sight,
        // filled the frame with giant out-of-focus sprites. Springs to a
        // radius and a plane give a torus whose size is a parameter.
        vec3 x = p.pos.xyz;
        vec3 v = p.vel.xyz;
        vec3 gravity = vec3(0.0);
        vec3 steer = vec3(0.0);
        vec3 steerV = vec3(0.0);
        float capture = 0.0;
        vec3 tiltRnd = vec3(hash(i * 3u + 101u), hash(i * 3u + 102u),
                            hash(i * 3u + 103u)) - 0.5;
        float orbitR = uEddyOrbit * (0.35 + 0.65 * hash(i * 3u + 104u));
        for (int e = 0; e < uEddyCount; ++e) {
            vec4 nova = uEddyNova[e];
            if (nova.y > 0.0) {
                // The shock: a radial shove concentrated in a shell around
                // the front, which widens as it travels. Dust it has already
                // passed is left coasting outward, dust it has not reached
                // yet is untouched -- which is what makes the front visible.
                vec3 rel = x - uEddyPos[e].xyz;
                float r = max(length(rel), 1e-3);
                float w = 0.25 + 0.15 * nova.x;
                float s = (r - nova.x) / w;
                gravity += rel / r * nova.y * exp(-s * s);
            }
            float pull = uEddyPos[e].w;
            if (pull <= 0.0) continue;
            vec3 rel = x - uEddyPos[e].xyz;
            float r2 = dot(rel, rel) + uEddySoftening * uEddySoftening;
            float r = sqrt(r2);
            float c = smoothstep(uEddyCapture, uEddyCapture * 0.6, r)
                    * min(pull, 1.0);
            gravity -= (1.0 - c) * pull * rel / (r2 * r);
            if (c <= 0.0) continue;

            vec3 axis = normalize(uEddyAxis[e].xyz + tiltRnd * uEddyTilt);
            float h = dot(rel, axis);
            vec3 inPlane = rel - h * axis;
            float rho = length(inPlane);
            if (rho < 1e-3) continue;   // on the axis itself: no orbit defined
            vec3 radial = inPlane / rho;
            vec3 tangent = cross(axis, radial);
            float vt = sqrt(pull / orbitR) * uEddyOrbitSpeed * uEddyAxis[e].w;
            steerV += c * tangent * vt;
            steer += c * (radial * (orbitR - rho) * 2.0 - axis * h * uEddyFlatten);
            capture = max(capture, c);
        }
        float free_ = 1.0 - capture;
        // The drag target blends from "move with the cloud" to "orbit".
        vec3 targetV = cl.vel.xyz * free_ + steerV;
        vec3 accel = (home - x) * uCohesion * free_
                   - (v - targetV) * mix(uDrag, uEddyLock, capture)
                   + gravity + steer
                   + stir(x + float(seed) * 0.37, uTime) * uTurbulence;
        p.vel.xyz += accel * uDt;
        p.pos.xyz += p.vel.xyz * uDt;
    }
    particles[i] = p;
}
